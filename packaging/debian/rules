#!/usr/bin/make -f
%:
	dh $@ --with=systemd

override_dh_auto_install:
	dh_auto_install -- LIBDIR=/lib/$(DEB_HOST_MULTIARCH) VERSION=$(VERSION)
	install -d debian/google-compute-engine-oslogin/lib/systemd/system/systemd-logind.service.d
	install -m 0644 systemd-logind-oslogin.conf debian/google-compute-engine-oslogin/lib/systemd/system/systemd-logind.service.d/oslogin.conf

override_dh_systemd_enable:
	dh_systemd_enable google-oslogin-cache.timer

override_dh_systemd_start:
	dh_systemd_start google-oslogin-cache.timer
